@dataclass
class ServerConfig:
    GEMINI_MODEL: str = "models/gemini-1.5-flash"
    MAX_IMAGE_SIZE: int = 1600  # Max dimension to avoid huge token usage
    GEMINI_RETRY_ATTEMPTS: int = 3
    GEMINI_RETRY_DELAY: int = 5  # Seconds to wait between quota retries

CONFIG = ServerConfig()

# ----------------------------------------------------------------------------
# LLM Client: Centralized Gemini Service
# ----------------------------------------------------------------------------
class LLMClient:
    """Handles interactions with Google Gemini 1.5 Flash."""

    def __init__(self, config: ServerConfig):
        self.config = config
        api_key = os.getenv("GEMINI_API_KEY")
        if not api_key:
            logger.error("❌ GEMINI_API_KEY not found in .env")
        genai.configure(api_key=api_key)
        self.model = genai.GenerativeModel(self.config.GEMINI_MODEL)

    def _clean_json(self, text: str) -> str:
        """Removes markdown blocks and whitespace."""
        text = text.strip()
        text = re.sub(r"^```(json)?", "", text).strip()
        text = re.sub(r"```$", "", text).strip()
        return text

    def _resize_image(self, image_path: str) -> Image.Image:
        """Resizes image to prevent quota issues and speed up processing."""
        img = Image.open(image_path)
        if max(img.size) > self.config.MAX_IMAGE_SIZE:
            img.thumbnail((self.config.MAX_IMAGE_SIZE, self.config.MAX_IMAGE_SIZE), Image.LANCZOS)
        return img

    def call_gemini_multimodal(self, prompt: str, image_paths: List[str]) -> Dict[str, Any]:
        """
        Sends one or more images and a prompt to Gemini.
        Includes robust retry logic for 429 (Quota) errors.
        """
        # Prepare the multimodal content (Prompt + Images)
        content = [prompt]
        for path in image_paths:
            content.append(self._resize_image(path))

        for attempt in range(1, self.config.GEMINI_RETRY_ATTEMPTS + 1):
            try:
                logger.info(f"Gemini request attempt {attempt}...")
                response = self.model.generate_content(
                    content,
                    request_options={"timeout": 120}
                )
                cleaned = self._clean_json(response.text)
                return json.loads(cleaned)

            except Exception as e:
                error_msg = str(e).lower()
                # Check if it's a quota/limit error (429)
                if "429" in error_msg or "quota" in error_msg or "resource exhausted" in error_msg:
                    logger.warning(f"⚠️ Gemini Quota exceeded. Retrying in {self.config.GEMINI_RETRY_DELAY}s... ({attempt}/{self.config.GEMINI_RETRY_ATTEMPTS})")
                    if attempt < self.config.GEMINI_RETRY_ATTEMPTS:
                        time.sleep(self.config.GEMINI_RETRY_DELAY * attempt)
                        continue

                logger.error(f"Gemini critical error: {e}")
                raise e

# ----------------------------------------------------------------------------
# CNI Processor: Gemini-Based Extraction
# ----------------------------------------------------------------------------
class CniProcessor:
    """Handles extraction of CNI data using Gemini's multimodal capabilities."""

    def __init__(self, llm_client: LLMClient):
        self.llm_client = llm_client

    def extract_cni_data(self, image_paths: List[str]) -> Dict[str, Any]:
        """Sends all CNI images to Gemini for fusion and structuring."""
        prompt = """Tu es un expert en analyse de documents administratifs, spécialisé dans les Cartes Nationales d'Identité (CNI) du Cameroun.
Analyse l'image (ou les images) fournie(s) pour extraire les informations suivantes.
Les images peuvent contenir le recto, le verso, ou les deux faces combinées.

CONSIGNES :
1. Fusionne intelligemment toutes les informations présentes sur les différentes images.
2. Si un champ est manquant ou illisible, mets la valeur null.
3. Ne jamais inventer de données.
4. RÉPOND UNIQUEMENT avec un objet JSON valide, sans texte autour.

FORMAT JSON ATTENDU :
{
  "nom": null,
  "prenoms": null,
  "date_naissance": null,
  "lieu_naissance": null,
  "date_expiration": null,
  "nom_pere": null,
  "nom_mere": null,
  "profession": null,
  "numero_cni": null,
  "date_delivrance": null
}"""
        return self.llm_client.call_gemini_multimodal(prompt, image_paths)

# ----------------------------------------------------------------------------
# Plan Processor: Gemini-Based Extraction
# ----------------------------------------------------------------------------
class PlanProcessor:
    """Handles extraction of location plans using Gemini."""

    def __init__(self, llm_client: LLMClient):
        self.llm_client = llm_client

    def extract_plan_data(self, image_path: str) -> Dict[str, Any]:
        """Sends the location plan image to Gemini."""
        prompt = """Tu es un expert en extraction de données manuscrites pour des documents bancaires.
Analyse l'image de ce plan de localisation et extrais les informations suivantes sous forme de JSON strict.
Si une information est manquente ou illisible, mets une chaîne vide "".
Ne rajoute aucun texte avant ou après le JSON, pas de balises markdown.

FORMAT JSON ATTENDU :
{
  "ville": "",
  "quartier": "",
  "tel1": "",
  "tel2": "",
  "email": "",
  "datePlan": "",
  "contact1Nom": "",
  "contact1Tel1": "",
  "contact1Tel2": "",
  "contact2Nom": "",
  "contact2Tel1": "",
  "contact2Tel2": ""
}"""
        # Send as a list to maintain multimodal interface
        return self.llm_client.call_gemini_multimodal(prompt, [image_path])

